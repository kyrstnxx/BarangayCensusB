@page
@model BarangayCensus.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Admin Login";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div style="min-height:80vh; display:flex; align-items:center; justify-content:center;">
    <div style="background:white; border-radius:12px; border:1px solid #d0e8d5; padding:40px; width:100%; max-width:420px;">

        <div style="text-align:center; margin-bottom:28px;">
            <div style="width:60px; height:60px; background:#d4edda; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 12px;">
                <span style="font-size:24px;">🔒</span>
            </div>
            <h2 style="color:#1B6B2F; font-weight:600; margin:0;">Admin Login</h2>
            <p style="color:#6c757d; font-size:14px; margin-top:6px;">Authorized personnel only</p>
        </div>

        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div style="margin-bottom:16px;">
                <label style="font-size:13px; color:#495057; display:block; margin-bottom:5px;">Email address</label>
                <input name="Input.Email" type="email" class="form-control" style="border-color:#d0e8d5;" />
            </div>

            <div style="margin-bottom:24px;">
                <label style="font-size:13px; color:#495057; display:block; margin-bottom:5px;">Password</label>
                <input name="Input.Password" type="password" class="form-control" style="border-color:#d0e8d5;" />
            </div>

            <button type="submit" style="width:100%; background:#1B6B2F; color:white; border:none; padding:12px; border-radius:8px; font-size:15px; font-weight:500; cursor:pointer;">
                Sign in
            </button>
        </form>

    </div>
</div>