@model BarangayCensus.Models.Entities.Resident
@{
    ViewData["Title"] = "Edit Resident";
}

@if (Model == null)
{
    <p>Resident not found.</p>
}
else
{
    <h2>Edit Resident</h2>
    <form method="post">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="FirstName" class="form-label"></label>
            <input asp-for="FirstName" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="LastName" class="form-label"></label>
            <input asp-for="LastName" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="MiddleName" class="form-label"></label>
            <input asp-for="MiddleName" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="DateOfBirth" class="form-label"></label>
            <input asp-for="DateOfBirth" type="date" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Gender" class="form-label"></label>
            <select asp-for="Gender" class="form-select">
                <option>Male</option>
                <option>Female</option>
            </select>
        </div>
        <div class="mb-3">
            <label asp-for="CivilStatus" class="form-label"></label>
            <select asp-for="CivilStatus" class="form-select">
                <option>Single</option>
                <option>Married</option>
                <option>Widowed</option>
                <option>Separated</option>
            </select>
        </div>
        <div class="mb-3">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="ContactNumber" class="form-label"></label>
            <input asp-for="ContactNumber" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Occupation" class="form-label"></label>
            <input asp-for="Occupation" class="form-control" />
        </div>
        <div class="form-check mb-2">
            <input asp-for="IsVoter" class="form-check-input" type="checkbox" />
            <label asp-for="IsVoter" class="form-check-label">Registered Voter</label>
        </div>
        <div class="form-check mb-2">
            <input asp-for="IsPWD" class="form-check-input" type="checkbox" />
            <label asp-for="IsPWD" class="form-check-label">PWD</label>
        </div>
        <div class="form-check mb-3">
            <input asp-for="IsSeniorCitizen" class="form-check-input" type="checkbox" />
            <label asp-for="IsSeniorCitizen" class="form-check-label">Senior Citizen</label>
        </div>

        <button type="submit" class="btn btn-success">Save Changes</button>
        <a asp-action="List" class="btn btn-secondary ms-2">Cancel</a>
    </form>

    <form asp-action="Delete" asp-controller="Residents" method="post" style="display:inline">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-danger ms-2"
                onclick="return confirm('Are you sure you want to delete this record?')">
            Delete
        </button>
    </form>
}