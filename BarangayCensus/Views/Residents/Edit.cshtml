@model BarangayCensus.Models.Entities.Resident
@{
    ViewData["Title"] = "Edit Resident";
}

@if (Model == null)
{
    <p>Resident not found.</p>
}
else
{
    <div style="max-width:700px; margin:0 auto;">
        <div style="margin-bottom:24px;">
            <h2 style="color:#1a2e1f; font-weight:600; font-size:1.5rem; margin-bottom:4px;">Edit Resident</h2>
            <p style="color:#4a6352; font-size:14px;">Update resident information below.</p>
        </div>

        <div style="background:white; border:1px solid #d0e8d5; border-radius:10px; padding:32px;">
            <form method="post">
                <input type="hidden" asp-for="Id" />

                <p style="font-size:11px; font-weight:600; color:#1B6B2F; text-transform:uppercase; letter-spacing:.08em; margin-bottom:16px;">Personal Information</p>

                <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px; margin-bottom:16px;">
                    <div>
                        <label style="font-size:12px; color:#4a6352; display:block; margin-bottom:5px;">First Name</label>
                        <input asp-for="FirstName" class="form-control" style="border-color:#d0e8d5; font-size:13px;" />
                    </div>
                    <div>
                        <label style="font-size:12px; color:#4a6352; display:block; margin-bottom:5px;">Last Name</label>
                        <input asp-for="LastName" class="form-control" style="border-color:#d0e8d5; font-size:13px;" />
                    </div>
                    <div>
                        <label style="font-size:12px; color:#4a6352; display:block; margin-bottom:5px;">Middle Name</label>
                        <input asp-for="MiddleName" class="form-control" style="border-color:#d0e8d5; font-size:13px;" />
                    </div>
                    <div>
                        <label style="font-size:12px; color:#4a6352; display:block; margin-bottom:5px;">Date of Birth</label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" style="border-color:#d0e8d5; font-size:13px;" />
                    </div>
                    <div>
                        <label style="font-size:12px; color:#4a6352; display:block; margin-bottom:5px;">Gender</label>
                        <select asp-for="Gender" class="form-select" style="border-color:#d0e8d5; font-size:13px;">
                            <option>Male</option>
                            <option>Female</option>
                        </select>
                    </div>
                    <div>
                        <label style="font-size:12px; color:#4a6352; display:block; margin-bottom:5px;">Civil Status</label>
                        <select asp-for="CivilStatus" class="form-select" style="border-color:#d0e8d5; font-size:13px;">
                            <option>Single</option>
                            <option>Married</option>
                            <option>Widowed</option>
                            <option>Separated</option>
                        </select>
                    </div>
                </div>

                <p style="font-size:11px; font-weight:600; color:#1B6B2F; text-transform:uppercase; letter-spacing:.08em; margin-bottom:16px;">Contact & Location</p>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
                    <div style="grid-column:span 2;">
                        <label style="font-size:12px; color:#4a6352; display:block; margin-bottom:5px;">Address</label>
                        <input asp-for="Address" class="form-control" style="border-color:#d0e8d5; font-size:13px;" />
                    </div>
                    <div>
                        <label style="font-size:12px; color:#4a6352; display:block; margin-bottom:5px;">Contact Number</label>
                        <input asp-for="ContactNumber" class="form-control" style="border-color:#d0e8d5; font-size:13px;" />
                    </div>
                    <div>
                        <label style="font-size:12px; color:#4a6352; display:block; margin-bottom:5px;">Occupation</label>
                        <input asp-for="Occupation" class="form-control" style="border-color:#d0e8d5; font-size:13px;" />
                    </div>
                </div>

                <p style="font-size:11px; font-weight:600; color:#1B6B2F; text-transform:uppercase; letter-spacing:.08em; margin-bottom:16px;">Classifications</p>

                <div style="display:flex; gap:24px; margin-bottom:28px;">
                    <label style="display:flex; align-items:center; gap:7px; font-size:13px; color:#4a6352; cursor:pointer;">
                        <input asp-for="IsVoter" type="checkbox" style="accent-color:#1B6B2F; width:15px; height:15px;" /> Registered Voter
                    </label>
                    <label style="display:flex; align-items:center; gap:7px; font-size:13px; color:#4a6352; cursor:pointer;">
                        <input asp-for="IsPWD" type="checkbox" style="accent-color:#1B6B2F; width:15px; height:15px;" /> PWD
                    </label>
                    <label style="display:flex; align-items:center; gap:7px; font-size:13px; color:#4a6352; cursor:pointer;">
                        <input asp-for="IsSeniorCitizen" type="checkbox" style="accent-color:#1B6B2F; width:15px; height:15px;" /> Senior Citizen
                    </label>
                </div>

                <div style="display:flex; gap:8px; padding-top:20px; border-top:1px solid #f0f7f2;">
                    <button type="submit" style="background:#1B6B2F; color:white; border:none; padding:10px 24px; border-radius:8px; font-size:13px; font-weight:500; cursor:pointer;">
                        Save Changes
                    </button>
                    <a asp-action="List" style="background:#f8f9fa; color:#4a6352; border:1px solid #d0e8d5; padding:10px 20px; border-radius:8px; font-size:13px; text-decoration:none;">
                        Cancel
                    </a>
                </div>
            </form>

            <form asp-action="Delete" asp-controller="Residents" method="post" style="margin-top:12px;">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" onclick="return confirm('Are you sure you want to delete this record?')"
                        style="background:white; color:#b91c1c; border:1px solid #f09595; padding:10px 20px; border-radius:8px; font-size:13px; cursor:pointer;">
                    Delete Resident
                </button>
            </form>
        </div>
    </div>
}